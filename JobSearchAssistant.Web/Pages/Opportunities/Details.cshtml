@page "{id:int}"
@model JobSearchAssistant.Web.Pages.Opportunities.DetailsModel
@{
    ViewData["Title"] = "Opportunity Details";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Opportunity Details</h1>
    <a asp-page="/Index" class="btn btn-secondary">Back to Inbox</a>
</div>

<dl class="row">
    <dt class="col-sm-3">Company</dt>
    <dd class="col-sm-9">
        @(string.IsNullOrWhiteSpace(Model.Opportunity.CompanyName)
            ? "Not specified"
            : Model.Opportunity.CompanyName)
    </dd>

    <dt class="col-sm-3">Job Title</dt>
    <dd class="col-sm-9">
        @(string.IsNullOrWhiteSpace(Model.Opportunity.JobTitle)
            ? "Not specified"
            : Model.Opportunity.JobTitle)
    </dd>

    <dt class="col-sm-3">Captured</dt>
    <dd class="col-sm-9">
        @Model.Opportunity.CapturedAtUtc.ToLocalTime().ToString("f")
    </dd>

    <dt class="col-sm-3">Source URL</dt>
    <dd class="col-sm-9">
        <a href="@Model.Opportunity.SourceUrl"
           target="_blank"
           rel="noopener noreferrer">
            @Model.Opportunity.SourceUrl
        </a>
    </dd>
</dl>

<hr />

<h2>Original Job Posting</h2>

<div class="border rounded p-3" style="white-space: pre-wrap;">@Model.Opportunity.OriginalPostingText</div>
