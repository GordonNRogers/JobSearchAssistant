@page
@model JobSearchAssistant.Web.Pages.Opportunities.CreateModel
@{
    ViewData["Title"] = "Capture Opportunity";
}

<h1>Capture Job Opportunity</h1>

@if (!string.IsNullOrEmpty(Model.DuplicateWarning))
{
    <div class="alert alert-warning" role="alert">
        <strong>Possible duplicate.</strong>
        @Model.DuplicateWarning

        <form method="post" class="mt-3">
            <input type="hidden" asp-for="Opportunity.SourceUrl" />
            <input type="hidden" asp-for="Opportunity.CompanyName" />
            <input type="hidden" asp-for="Opportunity.JobTitle" />
            <input type="hidden" asp-for="Opportunity.OriginalPostingText" />
            <input type="hidden" asp-for="ConfirmDuplicate" value="true" />

            <button type="submit" class="btn btn-warning">
                Save Anyway
            </button>
            <a asp-page="/Index" class="btn btn-secondary">
                Cancel
            </a>
        </form>
    </div>
}

<form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Opportunity.SourceUrl" class="form-label"></label>
        <input asp-for="Opportunity.SourceUrl" class="form-control" />
        <span asp-validation-for="Opportunity.SourceUrl"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Opportunity.CompanyName" class="form-label"></label>
        <input asp-for="Opportunity.CompanyName" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Opportunity.JobTitle" class="form-label"></label>
        <input asp-for="Opportunity.JobTitle" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Opportunity.OriginalPostingText"
               class="form-label"></label>
        <textarea asp-for="Opportunity.OriginalPostingText"
                  class="form-control"
                  rows="16"></textarea>
        <span asp-validation-for="Opportunity.OriginalPostingText"
              class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Save Opportunity</button>
    <a asp-page="/Index" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
